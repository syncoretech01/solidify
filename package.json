{
  "name": "solidify-transport",
  "version": "1.0.0",
  "private": true,
  "description": "Solidify Transport LLC — auto transport motor carrier. Marketing site, quote pipeline and secure owner-operator onboarding.",
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/images.mjs && node scripts/masks.mjs && next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "images": "node scripts/images.mjs",
    "images:force": "node scripts/images.mjs --force",
    "masks": "node scripts/masks.mjs",
    "imagery:sheet": "node scripts/fetch-imagery.mjs sheet",
    "qa": "node scripts/qa.mjs",
    "onboarding:smoke": "node scripts/onboarding-smoke.mjs",
    "onboarding:ui": "node scripts/onboarding-ui.mjs",
    "env:local": "node scripts/local-env.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@gsap/react": "^2.1.2",
    "@hookform/resolvers": "^5.2.1",
    "clsx": "^2.1.1",
    "gsap": "^3.15.0",
    "lenis": "^1.3.26",
    "next": "^16.3.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.62.0",
    "sharp": "^0.35.4",
    "three": "^0.185.1",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@types/three": "^0.185.4",
    "d3-geo": "^3.1.1",
    "playwright-core": "^1.62.1",
    "postcss": "^8.5.26",
    "tailwindcss": "^4.3.3",
    "topojson-client": "^3.1.0",
    "typescript": "^5.9.3",
    "us-atlas": "^3.0.1"
  },
  "engines": {
    "node": ">=20"
  }
}
