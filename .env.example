# ─────────────────────────────────────────────────────────────────────────────
# Solidify Transport — environment
#
# This website keeps NO submission record. Quote inquiries and approved-driver
# onboarding are validated, then delivered to Solidify by email; there is no
# database, no object store and nothing encrypted at rest, because there is
# nothing at rest. That is why this file is short.
#
# Every capability is a hard gate: if the variables below are missing, the
# write endpoints answer 503 and say so plainly. Nothing degrades quietly.
# ─────────────────────────────────────────────────────────────────────────────

# The public origin. Also the allowed Origin for every form POST.
NEXT_PUBLIC_SITE_URL=https://solidifytransport.com


# ── Delivery ─────────────────────────────────────────────────────────────────
# Without RESEND_API_KEY nothing can be submitted at all — the forms fall back
# to the phone number and say so.

RESEND_API_KEY=

# The From address. Must be a domain verified with the provider.
MAIL_FROM_EMAIL=quotes@solidifytransport.com

# Where quote and dealership inquiries go.
INQUIRY_TO_EMAIL=

# Where approved-driver onboarding goes. DELIBERATELY has no fallback to
# INQUIRY_TO_EMAIL: these messages carry a taxpayer identification number and
# bank account details, and must land in a mailbox chosen on purpose — one
# with MFA and restricted membership.
ONBOARDING_TO_EMAIL=


# ── The onboarding gate ──────────────────────────────────────────────────────

# Comma-separated sha256 hex digests of the access codes you hand to approved
# operators. One per operator so a code can be retired on its own:
#   node -e "console.log(require('crypto').createHash('sha256').update('THE-CODE').digest('hex'))"
ONBOARDING_ACCESS_CODE_HASHES=

# Signs the 2-hour session cookie. At least 32 characters:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
ONBOARDING_SESSION_SECRET=


# ── Limits (optional; the defaults are the right ones) ───────────────────────
# Vercel caps a request body at 4.5 MB and one submission carries every
# document, so these two numbers are what keep a submission deliverable.
# Images are downscaled in the browser before they are counted.

# Per document, after any client-side reduction. Default 2 MiB.
ONBOARDING_MAX_UPLOAD_BYTES=2097152

# Every document in one submission, added together. Default 3.5 MiB.
ONBOARDING_MAX_TOTAL_UPLOAD_BYTES=3670016


# ── Durable rate limiting (optional) ─────────────────────────────────────────
# Without these, limits are per warm serverless instance — enough for a small
# site, but Upstash makes them real across instances.

UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=


# ── Local testing only ───────────────────────────────────────────────────────
# Points the mailer at scripts/mail-sink.mjs so "delivered" still means a real
# 2xx. IGNORED when NODE_ENV=production — it cannot redirect live mail.
# RESEND_API_BASE=http://127.0.0.1:3479
