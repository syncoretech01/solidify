# ══════════════════════════════════════════════════════════════════════════
# SOLIDIFY TRANSPORT — environment
# Copy to .env.local and fill in. Nothing here is committed.
# ══════════════════════════════════════════════════════════════════════════

# Public site origin. Drives canonical URLs, sitemap, OpenGraph and the
# CSRF origin allowlist. No trailing slash.
NEXT_PUBLIC_SITE_URL=https://solidifytransport.com

# ── Inquiries (quote / OEM / contact) ─────────────────────────────────────
# Submissions are always stored server-side when a store is configured.
# Email is sent additionally once these are set. Resend REST API, no SDK.
INQUIRY_TO_EMAIL=
RESEND_API_KEY=
INQUIRY_FROM_EMAIL=quotes@solidifytransport.com

# ── Onboarding: encryption ─────────────────────────────────────────────────
# base64 of exactly 32 random bytes. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Without this, every onboarding write endpoint returns 503 and the UI locks.
ONBOARDING_ENCRYPTION_KEY=
# Identifies which key encrypted a record, so keys can be rotated later.
ONBOARDING_KEY_ID=k1

# ── Onboarding: storage ────────────────────────────────────────────────────
# "s3"  — S3-compatible object storage (AWS S3, Cloudflare R2, Backblaze B2,
#         MinIO). REQUIRED on Vercel/serverless: the filesystem there is
#         ephemeral and a file store would silently lose submissions.
# "fs"  — local filesystem. Development and long-lived Node hosts only.
#         Refused automatically when running on Vercel.
ONBOARDING_STORE=s3
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Prefix inside the bucket for onboarding records.
S3_PREFIX=onboarding
# For ONBOARDING_STORE=fs only. Keep it outside the web root.
ONBOARDING_STORE_DIR=./.data/onboarding

# ── Onboarding: access ─────────────────────────────────────────────────────
# Approved operators unlock the stepper with a code Solidify gives them.
# Comma-separated SHA-256 hex digests of the codes (never the codes).
#   node -e "console.log(require('crypto').createHash('sha256').update('THE-CODE').digest('hex'))"
ONBOARDING_ACCESS_CODE_HASHES=
# Secret used to sign the onboarding session cookie. 32+ random bytes, base64.
ONBOARDING_SESSION_SECRET=

# ── Onboarding: reviewer read-back ─────────────────────────────────────────
# Bearer token for GET /api/onboarding/records/:id. Unset means nobody can.
ONBOARDING_ADMIN_TOKEN=

# ── Onboarding: retention ──────────────────────────────────────────────────
# Days a completed submission is kept before the purge routine deletes it.
ONBOARDING_RETENTION_DAYS=90

# ── Rate limiting ──────────────────────────────────────────────────────────
# Optional Upstash Redis REST credentials for durable limiting across
# serverless instances. Without them an in-memory per-instance limiter runs.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Upload limit ───────────────────────────────────────────────────────────
# Bytes. Vercel serverless request bodies cap near 4.5 MB, so 4 MB default.
ONBOARDING_MAX_UPLOAD_BYTES=4194304

# ── Retention cron ─────────────────────────────────────────────────────────
# Vercel Cron calls GET /api/onboarding/purge daily (see vercel.json) with
# "Authorization: Bearer <CRON_SECRET>". Vercel sets this automatically when
# a project has crons; set it yourself elsewhere. The purge route also
# accepts ONBOARDING_ADMIN_TOKEN for manual runs.
CRON_SECRET=

# ── Onboarding: key rotation (optional) ───────────────────────────────────
# Decrypt-only older keys as "kid=base64,kid=base64". Every record carries
# the key id that encrypted it. To rotate: move the current key here under
# its id, issue a new ONBOARDING_ENCRYPTION_KEY + ONBOARDING_KEY_ID, then
# re-encrypt existing records (see lib/server/README.md).
ONBOARDING_PREVIOUS_KEYS=
